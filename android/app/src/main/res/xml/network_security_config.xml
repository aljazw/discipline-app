<?xml version="1.0" encoding="utf-8"?>
<!-- Offline maps are served to the map view by a tiny HTTP server on this
     phone (map/TileServer.kt). Plain HTTP is allowed only for that loopback
     address; everything else stays HTTPS-only. Debug builds also need the
     Metro bundler on localhost / 10.0.2.2. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
